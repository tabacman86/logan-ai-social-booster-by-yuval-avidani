{
  "manifest_version": 3,
  "name": "YUV.AI SocialBot Pro - Smart Auto Engager",
  "version": "2.0",
  "description": "AI-powered social media automation by YUV.AI - Automatically engage with LinkedIn and Facebook posts using personalized AI responses",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://linkedin.com/*",
    "https://www.facebook.com/*",
    "https://facebook.com/*",
    "https://api.cohere.ai/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://linkedin.com/*"
      ],
      "js": ["linkedin-content.js"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://facebook.com/*"
      ],
      "js": ["facebook-content.js"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "YUV.AI SocialBot Pro"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  }
} 